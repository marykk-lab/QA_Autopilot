{
  "name": "ai-qa-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Describe a test in natural language; get a real Playwright test you own.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "gen": "tsx scripts/gen.ts",
    "fix": "tsx scripts/fix.ts",
    "inspect": "tsx scripts/inspect.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^3.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
