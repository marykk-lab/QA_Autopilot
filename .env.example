# Generation. Without a key the app runs in cache-only mode: requests that are
# already in cache/ replay for free, anything else is refused with an explanation.
ANTHROPIC_API_KEY=

# Site under test. Overrides target.json's inspect.baseURL.
BASE_URL=https://www.saucedemo.com

# Supabase. `npm run db:start` prints both of these; a hosted project has them
# under Project Settings → API. Local defaults are filled in below.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Credentials for the app under test, referenced by name from target.json as
# usernameEnv / passwordEnv. Never put a real password in target.json itself —
# it is committed; this file is not.
# FEEDBOON_EMAIL=
# FEEDBOON_PASSWORD=
